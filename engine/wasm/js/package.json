{
  "name": "@bloodflow/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client wrappers for the Blood Flow Mahjong WASM engine",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts",
    "./pkg": {
      "types": "../pkg/bloodflow_mahjong_wasm.d.ts",
      "import": "../pkg/bloodflow_mahjong_wasm.js"
    }
  },
  "files": [
    "src",
    "../pkg"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:only": "node --experimental-strip-types --test --test-isolation=none tests"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  }
}
